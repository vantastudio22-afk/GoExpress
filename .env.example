# Copiá este archivo como ".env" y completá los valores. Nunca subas ".env" a un repositorio.

# --- Servidor ---
PORT=3000
NODE_ENV=development            # usar "production" cuando se publique
APP_URL=http://localhost:3000   # dirección pública de la app (se usa en los emails de recuperación)
TRUST_PROXY=0                   # poner 1 si hay un proxy inverso (Nginx, Render, Railway, etc.)

# --- Seguridad (OBLIGATORIO en producción) ---
# Generá una clave larga y aleatoria:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
SESSION_DAYS=7

# --- Base de datos (SQLite, un solo archivo) ---
# DB_FILE=./data/goexpress.db

# --- Mapas (OpenStreetMap: no requiere clave) ---
GEO_USER_AGENT=GoExpress/1.0 (contacto: tu-email@dominio.com)   # Nominatim exige identificar tu app
GEO_COUNTRY=ar                  # país para priorizar la búsqueda de direcciones
# NOMINATIM_URL=https://nominatim.openstreetmap.org   # cambiar por un servidor propio en producción
# OSRM_URL=https://router.project-osrm.org            # cambiar por un servidor propio en producción
GPS_STALE_SECONDS=120           # segundos sin señal para mostrar "última ubicación conocida"

# --- Emails de recuperación de contraseña (Resend: https://resend.com) ---
RESEND_API_KEY=
EMAIL_FROM=GoExpress <no-responder@tu-dominio.com>

# --- Primer administrador automático (opcional; para hostings sin consola) ---
# Se crea al iniciar solo si todavía no existe ningún administrador.
# ADMIN_NAME=Tu Nombre
# ADMIN_EMAIL=tu-email@dominio.com
# ADMIN_PASSWORD=
